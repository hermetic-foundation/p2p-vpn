<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/on_surface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/export_diagnostics"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/export_diagnostics"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_save"
            android:tint="@color/on_surface"
            android:tooltipText="@string/export_diagnostics" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/networks_title"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/networks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@color/outline"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                android:id="@+id/empty_networks"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="144dp"
                android:text="@string/no_networks" />

            <LinearLayout
                android:id="@+id/profile_recovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/BodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:text="@string/profile_unreadable" />

                <Button
                    android:id="@+id/reset_profile"
                    style="@style/CommandButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/danger"
                    android:text="@string/reset_profile"
                    android:textColor="@color/on_danger" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_status"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/add_network"
        style="@style/CommandButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/primary"
        android:drawableStart="@android:drawable/ic_input_add"
        android:drawablePadding="8dp"
        android:drawableTint="@color/on_primary"
        android:text="@string/add_network"
        android:textColor="@color/on_primary" />
</LinearLayout>
