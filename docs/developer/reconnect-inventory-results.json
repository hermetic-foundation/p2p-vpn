  "observer_script": "set pagination off\nset confirm off\nset debuginfod enabled off\nset auto-load off\nset print frame-arguments none\nset print address off\nattach 18\nset language c\npython\nimport gdb, struct, json, time\nsamples = 0\nexit_code = None\ndef inventory():\n    global samples\n    samples += 1\n    if samples > 128:\n        raise gdb.GdbError(\"snapshot quota exceeded\")\n    base = int(gdb.parse_and_eval(\"(unsigned long long)&'stats_alloc::INSTRUMENTED_SYSTEM'\"))\n    values = struct.unpack(\"<65546q\", bytes(gdb.selected_inferior().read_memory(base, 0x80050)))\n    rows = [(i, count) for i, count in enumerate(values[:65537]) if count]\n    oversized_blocks, oversized_bytes, failures = values[65537:65540]\n    allocs, frees, resizes, allocated_bytes, freed_bytes, resized_bytes = values[65540:]\n    blocks = sum(count for _, count in rows) + oversized_blocks\n    size = sum(i * count for i, count in rows) + oversized_bytes\n    coherent = blocks == allocs - frees and size == allocated_bytes - freed_bytes and failures == 0\n    if len(rows) > 512:\n        raise gdb.GdbError(\"row quota exceeded\")\n    print(\"FROZEN_INVENTORY\", json.dumps({\"index\": samples, \"unix_millis\": int(time.time() * 1000), \"rows\": rows, \"bytes\": size, \"blocks\": blocks, \"oversized_blocks\": oversized_blocks, \"oversized_bytes\": oversized_bytes, \"failures\": failures, \"coherent\": coherent}))\ndef ended(event):\n    global exit_code\n    exit_code = getattr(event, \"exit_code\", None)\n    print(\"FROZEN_END\", json.dumps({\"exit_code\": exit_code, \"samples\": samples}))\ngdb.events.exited.connect(ended)\nfor symbol in (\"tun_namespace::allocation_sample::emit\", \"tun_namespace::allocation_sample::emit_sizes\"):\n    bp = gdb.Breakpoint(symbol, internal=True)\n    bp.commands = \"silent\\npython inventory()\\ncontinue\\n\"\nprint(\"FROZEN_READY\", json.dumps({\"pid\": gdb.selected_inferior().pid, \"unix_millis\": int(time.time()*1000)}))\n\nend\ncontinue\npython assert exit_code == 0 and samples >= 24, \"incomplete inventory calibration\"\nquit\n\n",
